{
  "name": "@discordplus/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "deploy-commands": "tsx --env-file-if-exists=../../.env scripts/deploy-commands.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discordplus/db": "workspace:*",
    "@discordplus/shared": "workspace:*",
    "discord-api-types": "^0.38.56",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
