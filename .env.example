# Discord uygulaması: https://discord.com/developers/applications
# General Information → Application ID
DISCORD_CLIENT_ID=
# Bot → Reset Token
DISCORD_TOKEN=
# OAuth2 → Client Secret (web panelinde "Discord ile giriş" için)
DISCORD_CLIENT_SECRET=

# Oturum çerezlerini imzalayan gizli anahtar (en az 32 karakter), örn: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Veritabanı (docker compose ile çalıştırırken DATABASE_URL otomatik ayarlanır)
DATABASE_URL=postgres://discordplus:discordplus@localhost:5432/discordplus
POSTGRES_PASSWORD=discordplus

# Web sitesinin herkese açık adresi. Discord OAuth2 yönlendirme adresi bundan türetilir:
#   <WEB_URL>/api/auth/callback/discord
WEB_URL=http://localhost:3000

# Üretimde HTTPS için alan adı (docker compose --profile production)
DOMAIN=

# Doluysa slash komutları yalnızca bu test sunucusuna (anında) kaydolur
DEV_GUILD_ID=
LOG_LEVEL=info

# Silinen/düzenlenen mesaj logları için bellekteki mesaj önbelleği (isteğe bağlı)
# Kanal başına tutulan mesaj sayısı ve en uzun saklama süresi (saniye)
MESSAGE_CACHE_SIZE=100
MESSAGE_CACHE_LIFETIME_SECONDS=3600
